rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Règle de base pour les documents utilisateur :
    // Un utilisateur ne peut lire et écrire que ses propres données.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Favoris de l'utilisateur
      match /favorites/{trackId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Objectifs mensuels
      match /goals/{goalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Sessions d'écoute
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Journaux de sécurité :
    // Tout utilisateur authentifié peut enregistrer (créer) un journal de sécurité
    // (ex: tentatives biométriques échouées, suppressions sécurisées),
    // mais personne ne peut les modifier, les lire ou les supprimer pour préserver l'audit.
    match /security_logs/{logId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
